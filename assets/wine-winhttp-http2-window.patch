+/* Make room for length more unread bytes, reclaiming the already-read prefix
+ * before growing. The buffer doubles from a small start up to the window. */
+static BOOL body_reserve( struct http2_connection *h2, size_t length )
+{
+    size_t needed = h2->body_len + length, capacity;
+    BYTE *grown;
+    if (needed > H2_WINDOW) return FALSE;
+    if (h2->body_off + needed <= h2->body_cap) return TRUE;
+    if (h2->body_off)
+    {
+        memmove( h2->body, h2->body + h2->body_off, h2->body_len );
+        h2->body_off = 0;
+    }
+    if (needed <= h2->body_cap) return TRUE;
+    capacity = h2->body_cap ? h2->body_cap * 2 : H2_BODY_INITIAL;
+    if (capacity < needed) capacity = needed;
+    if (capacity > H2_WINDOW) capacity = H2_WINDOW;
+    if (!(grown = realloc( h2->body, capacity ))) return FALSE;
+    h2->body = grown;
+    h2->body_cap = capacity;
+    return TRUE;
+}
