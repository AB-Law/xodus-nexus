diff --git a/dlls/xgameruntime/xhttp_limits.h b/dlls/xgameruntime/xhttp_limits.h
new file mode 100644
index 0000000..6c0fbb8
--- /dev/null
+++ b/dlls/xgameruntime/xhttp_limits.h
@@ -0,0 +1,49 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later
+ * Time limits for Xbox service HTTP calls that a title waits on synchronously.
+ * Without them a silent server holds the calling thread for the WinHTTP
+ * defaults (minutes), and every retry repeats that wait. */
+#ifndef __WINE_XGAMERUNTIME_XHTTP_LIMITS_H
+#define __WINE_XGAMERUNTIME_XHTTP_LIMITS_H
+
+/* No winhttp.h here: this header is included next to wininet.h, which
+ * defines conflicting types. ERROR_WINHTTP_TIMEOUT is WINHTTP_ERROR_BASE + 2. */
+#define XHTTP_ERROR_WINHTTP_TIMEOUT 12002
+
+#define HTTP_RESOLVE_TIMEOUT   10000
+#define HTTP_CONNECT_TIMEOUT   10000
+#define HTTP_SEND_TIMEOUT      30000
+#define HTTP_RECEIVE_TIMEOUT   30000
+/* Time the server may take to start answering. A body is bounded by
+ * HTTP_RECEIVE_TIMEOUT per read instead: a transfer that keeps delivering data
+ * is never cut off, and one that goes quiet for that long is. */
+#define HTTP_RESPONSE_TIMEOUT  15000
+/* No new attempt starts once a request series has used this much time. */
+#define HTTP_RETRY_BUDGET      30000
+/* Safety ceiling on the whole initial cloud sync the title waits on. Stalled
+ * requests already time out on their own, so this is not what normally ends a
+ * sync: it only stops a server that keeps trickling data from holding the title
+ * forever. It is checked before each request, so a request already running may
+ * finish after it. */
+#define SAVE_SYNC_CEILING      600000
+
+static inline BOOL http_timed_out( HRESULT hr )
+{
+    return hr == HRESULT_FROM_WIN32( XHTTP_ERROR_WINHTTP_TIMEOUT ) || hr == HRESULT_FROM_WIN32( ERROR_TIMEOUT );
+}
+
+/* A timed-out attempt already used its whole budget, and a repeat would only
+ * extend the wait. Other failures may be transient and are retried while the
+ * series is still within HTTP_RETRY_BUDGET. */
+static inline BOOL http_retry_allowed( HRESULT hr, ULONGLONG started, ULONGLONG now )
+{
+    if (http_timed_out( hr )) return FALSE;
+    return now - started < HTTP_RETRY_BUDGET;
+}
+
+/* deadline 0 means no limit. */
+static inline BOOL http_deadline_passed( ULONGLONG deadline, ULONGLONG now )
+{
+    return deadline && now >= deadline;
+}
+
+#endif
